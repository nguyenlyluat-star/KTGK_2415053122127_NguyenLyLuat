<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView android:id="@+id/txtTen_127" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" />
    <TextView android:id="@+id/txtSoTien_127" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" />
    <TextView android:id="@+id/txtLoaiChi_127" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" />
    <TextView android:id="@+id/txtGhiChu_127" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" />
    <TextView android:id="@+id/txtTrangThai_127" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" />

    <Button
        android:id="@+id/btnChinhSua_127"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chỉnh sửa khoản chi" />

    <Button
        android:id="@+id/btnQuayLai_127"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quay lại" />
</LinearLayout>